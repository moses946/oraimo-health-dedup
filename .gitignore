# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# --- Oraimo Lab research artefacts ---
# Third-party APKs pulled from a phone for static analysis. Never committed by
# default: they are someone else's copyrighted binary and they are large.
research/apk/
research/decompiled/
# Raw HCI snoop captures and exported sessions can be large and may contain
# personal data (other paired devices, notification text). Opt in per file.
research/captures/*
!research/captures/.gitkeep
*.btsnoop
btsnoop_hci.log
